#############################################
# Utility command for edit_cache

build cmake/stm32cubemx/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Nlict\lichengji\cm4_stm32\build\Debug\cmake\stm32cubemx && D:\cmake\bin\cmake-gui.exe -SD:\Nlict\lichengji\cm4_stm32 -BD:\Nlict\lichengji\cm4_stm32\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build cmake/stm32cubemx/edit_cache: phony cmake/stm32cubemx/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Nlict\lichengji\cm4_stm32\build\Debug\cmake\stm32cubemx && D:\cmake\bin\cmake.exe --regenerate-during-build -SD:\Nlict\lichengji\cm4_stm32 -BD:\Nlict\lichengji\cm4_stm32\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

