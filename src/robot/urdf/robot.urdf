<?xml version="1.0" encoding="utf-8"?>
<robot name="robot">
  <!-- ==================================================================== -->
  <!-- 1. 基础车身链接：保留无摩擦支撑球（可选，防止车轮碰撞失效时下陷）    -->
  <!-- ==================================================================== -->
  <link name="base_Link">
    <!-- 惯性参数完全保留原值 -->
    <inertial>
      <origin xyz="-0.0098481 5.9245E-07 0.010215" rpy="0 0 0" />
      <mass value="200.0" />
      <inertia ixx="0.04144" ixy="0.000001849" ixz="0.00007185"
               iyy="0.03855" iyz="0.000000001813" izz="0.07036" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/base_Link.STL" />
      </geometry>
      <material name="base_material">
        <color rgba="1 0 0 1" />
      </material>
    </visual>

    <!-- 支撑球：可选保留（若车轮碰撞完全生效，可删除此碰撞体） -->
    <collision>
      <origin xyz="0 0 -0.0015" rpy="0 0 0" /> 
      <geometry>
        <sphere radius="0.005" />
      </geometry>
    </collision>

    <!-- 支撑球无摩擦配置 -->
    <gazebo reference="base_Link">
      <material>Gazebo/Red</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </link>

  <!-- ==================================================================== -->
  <!-- 2. 车轮链接：恢复碰撞体 + 摩擦设为0（仅保留碰撞检测）               -->
  <!-- ==================================================================== -->
  <!-- 车轮0链接 -->
  <link name="wheel_0_Link">
    <!-- 惯性参数完全保留原值 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_0_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 恢复车轮碰撞体（核心修改1） -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- 核心修改2：移除碰撞掩码 + 摩擦设为0（仅保留碰撞，无摩擦） -->
    <gazebo>
      <mu1>0.0</mu1>  <!-- 法向摩擦为0 -->
      <mu2>0.0</mu2>  <!-- 切向摩擦为0 -->
    </gazebo>
    <gazebo reference="wheel_0_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮0关节（保留原有配置，维持TF树） -->
  <joint name="wheel_0_Joint" type="continuous">
    <origin xyz="0.041864 0.066996 0.0225" rpy="0 0 -0.55851" />
    <parent link="base_Link" />
    <child link="wheel_0_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮1链接 -->
  <link name="wheel_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_1_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 恢复车轮碰撞体 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- 摩擦设为0（仅碰撞） -->
    <gazebo>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_1_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮1关节 -->
  <joint name="wheel_1_Joint" type="continuous">
    <origin xyz="0.041864 -0.066996 0.0225" rpy="0 0 -2.5831" />
    <parent link="base_Link" />
    <child link="wheel_1_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮2链接 -->
  <link name="wheel_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_2_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 恢复车轮碰撞体 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- 摩擦设为0（仅碰撞） -->
    <gazebo>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_2_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮2关节 -->
  <joint name="wheel_2_Joint" type="continuous">
    <origin xyz="-0.055861 -0.055861 0.0225" rpy="0 0 2.3562" />
    <parent link="base_Link" />
    <child link="wheel_2_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮3链接 -->
  <link name="wheel_3_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_3_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 恢复车轮碰撞体 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- 摩擦设为0（仅碰撞） -->
    <gazebo>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="wheel_3_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮3关节 -->
  <joint name="wheel_3_Joint" type="continuous">
    <origin xyz="-0.055861 0.055861 0.0225" rpy="0 0 0.7854" />
    <parent link="base_Link" />
    <child link="wheel_3_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- ==================================================================== -->
  <!-- 保留原有机械臂/嘴巴、运球机构配置（无碰撞）                         -->
  <!-- ==================================================================== -->
  <link name="mouth_Link">
    <inertial>
      <origin xyz="0.0061665 -0.041178 0.033013" rpy="0 0 0" />
      <mass value="20.952" />
      <inertia ixx="0.0048361" ixy="-0.000034805" ixz="-0.0001004"
               iyy="0.0015441" iyz="0.000025967" izz="0.0047443" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/mouth_Link.STL" />
      </geometry>
      <material name="mouth_material">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <gazebo reference="mouth_Link">
      <material>Gazebo/Blue</material>
      <damping>0.2</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <joint name="mouth_Joint" type="revolute">
    <origin xyz="0.0519 0.04365 0.0113" rpy="0 0 0" />
    <parent link="base_Link" />
    <child link="mouth_Link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.16" effort="150" velocity="0.8" />
  </joint>

  <link name="dribble_Link">
    <inertial>
      <origin xyz="2.2549E-05 0.0019168 0.00014443" rpy="0 0 0" />
      <mass value="1.7857" />
      <inertia ixx="0.00073784" ixy="-0.00000079042" ixz="0.00000018567"
               iyy="0.000025482" iyz="-0.0000036986" izz="0.00073795" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/dribble_Link.STL" />
      </geometry>
      <material name="dribble_material">
        <color rgba="0 1 0 1" />
      </material>
    </visual>
    <gazebo reference="dribble_Link">
      <material>Gazebo/Green</material>
      <damping>0.1</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <joint name="dribble_Joint" type="continuous">
    <origin xyz="0.015669 -0.0459 0.027271" rpy="0 -0.18761 0" />
    <parent link="mouth_Link" />
    <child link="dribble_Link" />
    <axis xyz="0 -1 0" />
  </joint>

  <!-- ==================================================================== -->
  <!-- 3. 传感器和核心控制插件（适配 Gazebo Fortress）                     -->
  <!-- ==================================================================== -->
  <!-- IMU传感器配置（完善噪声参数，Fortress必需） -->
  <gazebo reference="base_Link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu_internal</topic> <!-- Gazebo内部话题名 -->
      <pose>0 0 0 0 0 0</pose>
      <imu>
        <enable_orientation>true</enable_orientation>
      </imu>
    </sensor>
  </gazebo>

  <!-- Gazebo核心插件配置（替换PosePublisher为OdometryPublisher） -->
  <gazebo>
    <!-- 1. 速度控制插件（保留） -->
    <plugin
      filename="libignition-gazebo-velocity-control-system.so"
      name="ignition::gazebo::systems::VelocityControl">
      <link_name>base_Link</link_name>
      <topic>cmd_vel_internal</topic>
    </plugin>

    <!-- 2. 替换为真值里程计插件（核心修改） -->
    <plugin
      filename="libignition-gazebo-odometry-publisher-system.so"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>odom_internal</topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_Link</robot_base_frame>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0</gaussian_noise>
    </plugin>

    <!-- 3. IMU系统插件（保留） -->
    <plugin
      filename="libignition-gazebo-imu-system.so"
      name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- 保留命名空间配置 -->
    <robotNamespace>/</robotNamespace>
  </gazebo>

</robot>
