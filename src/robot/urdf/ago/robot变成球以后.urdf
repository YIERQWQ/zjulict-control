<?xml version="1.0" encoding="utf-8"?>
<robot name="robot">

  <!-- ros2_control硬件接口配置（完全保留原参数） -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="wheel_0_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_1_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_2_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="wheel_3_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="mouth_Joint">
      <command_interface name="effort">
        <param name="min">-150.0</param>
        <param name="max">150.0</param>
      </command_interface>
    </joint>

    <joint name="dribble_Joint">
      <command_interface name="effort">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
    </joint>
  </ros2_control>

  <!-- Gazebo仿真配置模块（强化碰撞禁用） -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/yixi/ROS/zjunlict/src/robot/config/controller_manager.yaml</parameters>
    </plugin>
    <robotNamespace>/</robotNamespace>
    
    <!-- 全局碰撞禁用：仅保留车轮碰撞 -->
    <disable_collisions link1="base_Link" link2="*" />
    <disable_collisions link1="mouth_Link" link2="*" />
    <disable_collisions link1="dribble_Link" link2="*" />
  </gazebo>

  <!-- 基础车身链接（重心调整至几何中心，完全无碰撞） -->
  <link name="base_Link">
    <!-- 惯性参数：origin改为几何中心(0,0,0)，mass/inertia保留放大后的值 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />  <!-- 核心修改：重心移到几何中心 -->
      <mass value="200.0" />
      <inertia ixx="0.04144" ixy="0.000001849" ixz="0.00007185"
               iyy="0.03855" iyz="0.000000001813" izz="0.07036" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/base_Link.STL" />
      </geometry>
      <material name="base_material">
        <color rgba="1 0 0 1" />
      </material>
    </visual>

    <!-- 车身完全无碰撞配置 -->
    <gazebo reference="base_Link">
      <material>Gazebo/Red</material>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 车轮0链接（仅修改摩擦参数，其余按比例放大，重心保持自身几何中心） -->
  <link name="wheel_0_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>

    <!-- 视觉模型完全保留原值 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_0_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>

    <!-- 碰撞体完全保留原值（仅车轮有碰撞） -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>

    <!-- Gazebo物理参数：仅添加/修改滚动/旋转摩擦，其余保留原值 -->
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp> <!-- 刚度：1e6，保证轮子不陷地 -->
      <kd>10.0</kd>      <!-- 阻尼：防止接触震荡 -->
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>    <!-- 新增：滚动摩擦 -->
      <rotational_friction>0</rotational_friction>  <!-- 新增：旋转摩擦 -->
    </gazebo>
    <gazebo reference="wheel_0_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮0关节（位置完全保留，确保车轮位置不变） -->
  <joint name="wheel_0_Joint" type="continuous">
    <origin xyz="0.055861 0.055861 0.0225" rpy="0 0 -0.7853981633974483" />  <!-- 车轮位置不变 -->
    <parent link="base_Link" />
    <child link="wheel_0_Link" />
    <axis xyz="0 1 0" />
    <limit effort="10000.0" velocity="50.0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮1链接（与车轮0参数完全一致） -->
  <link name="wheel_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_1_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>
      <rotational_friction>0</rotational_friction>
    </gazebo>
    <gazebo reference="wheel_1_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮1关节（位置完全保留） -->
  <joint name="wheel_1_Joint" type="continuous">
    <origin xyz="0.055861 -0.055861 0.0225" rpy="0 0 -2.356194490192345" />  <!-- 车轮位置不变 -->
    <parent link="base_Link" />
    <child link="wheel_1_Link" />
    <axis xyz="0 1 0" />
    <limit effort="10000.0" velocity="50.0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮2链接（与车轮0参数完全一致） -->
  <link name="wheel_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_2_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>
      <rotational_friction>0</rotational_friction>
    </gazebo>
    <gazebo reference="wheel_2_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮2关节（位置完全保留） -->
  <joint name="wheel_2_Joint" type="continuous">
    <origin xyz="-0.055861 -0.055861 0.0225" rpy="0 0 2.356194490192345" />  <!-- 车轮位置不变 -->
    <parent link="base_Link" />
    <child link="wheel_2_Link" />
    <axis xyz="0 1 0" />
    <limit effort="10000.0" velocity="50.0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 车轮3链接（与车轮0参数完全一致） -->
  <link name="wheel_3_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.001477" ixy="0" ixz="0"
               iyy="0.002940" iyz="0" izz="0.001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_3_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>0.001</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <min_depth>0.001</min_depth>
      <max_contacts>1</max_contacts>
      <rolling_friction>0</rolling_friction>
      <rotational_friction>0</rotational_friction>
    </gazebo>
    <gazebo reference="wheel_3_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮3关节（位置完全保留） -->
  <joint name="wheel_3_Joint" type="continuous">
    <origin xyz="-0.055861 0.055861 0.0225" rpy="0 0 0.7853981633974483" />  <!-- 车轮位置不变 -->
    <parent link="base_Link" />
    <child link="wheel_3_Link" />
    <axis xyz="0 1 0" />
    <limit effort="10000.0" velocity="50.0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- 机械臂/嘴巴链接（重心保持自身相对位置，不影响整车几何中心） -->
  <link name="mouth_Link">
    <inertial>
      <origin xyz="0.0061665 -0.041178 0.033013" rpy="0 0 0" />
      <mass value="0.00001" />
      <inertia ixx="0.0048361" ixy="-0.000034805" ixz="-0.0001004"
               iyy="0.0015441" iyz="0.000025967" izz="0.0047443" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/mouth_Link.STL" />
      </geometry>
      <material name="mouth_material">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <gazebo reference="mouth_Link">
      <material>Gazebo/Blue</material>
      <damping>0.2</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 机械臂关节（完全保留原值） -->
  <joint name="mouth_Joint" type="revolute">
    <origin xyz="0.0519 0.04365 0.0113" rpy="0 0 0" />
    <parent link="base_Link" />
    <child link="mouth_Link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.16" effort="150" velocity="0.8" />
  </joint>

  <!-- 运球机构链接（重心保持自身相对位置，不影响整车几何中心） -->
  <link name="dribble_Link">
    <inertial>
      <origin xyz="2.2549E-05 0.0019168 0.00014443" rpy="0 0 0" />
      <mass value="0.00001" />
      <inertia ixx="0.00073784" ixy="-0.00000079042" ixz="0.00000018567"
               iyy="0.000025482" iyz="-0.0000036986" izz="0.00073795" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/dribble_Link.STL" />
      </geometry>
      <material name="dribble_material">
        <color rgba="0 1 0 1" />
      </material>
    </visual>
    <gazebo reference="dribble_Link">
      <material>Gazebo/Green</material>
      <damping>0.1</damping>
      <collision_bitmask>0x0000</collision_bitmask>
      <max_contacts>0</max_contacts>
    </gazebo>
  </link>

  <!-- 运球机构关节（完全保留原值） -->
  <joint name="dribble_Joint" type="continuous">
    <origin xyz="0.015669 -0.0459 0.027271" rpy="0 -0.18761 0" />
    <parent link="mouth_Link" />
    <child link="dribble_Link" />
    <axis xyz="0 -1 0" />
  </joint>

</robot>

