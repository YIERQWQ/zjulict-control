<?xml version="1.0" encoding="utf-8"?>
<!-- 
  完整URDF文件说明：
  1. 适配ROS2 + Gazebo Fortress仿真
  2. 优化麦轮驱动直线稳定性（角度标准化/关节阻尼）
  3. 关闭非关键部件碰撞检测，避免干扰运动
  4. 碰撞体避开车轮，消除干涉问题
-->
<robot name="robot">

  <!-- 
    【修改点1：添加虚拟根连杆】
    目的：消除KDL运动学求解器的"根连杆无父节点"警告，
          确保URDF结构完整性，避免仿真启动报错
  这个会导致
  <link name="world" />
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_Link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>-->

  <!-- 
    【核心模块：ros2_control硬件接口配置】
    作用：定义关节的控制接口（力矩指令）和状态反馈接口，
          对接Gazebo的ros2_control插件实现硬件控制
  -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- 适配Gazebo Fortress的ros2_control插件 -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 车轮0关节：力矩控制接口（范围-100~100N·m） -->
    <joint name="wheel_0_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>  <!-- 位置反馈 -->
      <state_interface name="velocity"/>  <!-- 速度反馈 -->
    </joint>

    <!-- 车轮1关节：与wheel_0参数完全一致，保证对称 -->
    <joint name="wheel_1_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 车轮2关节：对称参数 -->
    <joint name="wheel_2_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 车轮3关节：对称参数 -->
    <joint name="wheel_3_Joint">
      <command_interface name="effort">
        <param name="min">-100.0</param>
        <param name="max">100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 机械臂/嘴巴关节：更大力矩范围（-150~150N·m）适配负载 -->
    <joint name="mouth_Joint">
      <command_interface name="effort">
        <param name="min">-150.0</param>
        <param name="max">150.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 运球机构关节：小力矩范围（-50~50N·m）适配高速旋转 -->
    <joint name="dribble_Joint">
      <command_interface name="effort">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- 
    【Gazebo仿真配置模块】
    核心修改：关闭mouth/dribble的碰撞检测，避免干扰小车运动
  -->
  <gazebo>
    <!-- ros2_control与Gazebo的桥接插件 -->
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <robot_param>robot_description</robot_param>          <!-- 机器人描述参数名 -->
      <robot_param_node>robot_state_publisher</robot_param_node>  <!-- 发布描述的节点 -->
      <parameters>/home/yixi/ROS/zjunlict/src/robot/config/controller_manager.yaml</parameters>  <!-- 控制器配置文件路径 -->
    </plugin>
    <robotNamespace>/</robotNamespace>  <!-- 命名空间 -->
    
    <!-- 
      【修改点2：全局碰撞禁用】
      原理：通过disable_collisions标签关闭指定链接的所有碰撞
      作用：机械臂/运球机构仅作视觉展示，不参与物理碰撞，避免卡滞或跑偏
    -->
    <disable_collisions link1="mouth_Link" link2="*" />      <!-- mouth_Link与所有物体无碰撞 -->
    <disable_collisions link1="dribble_Link" link2="*" />    <!-- dribble_Link与所有物体无碰撞 -->
  </gazebo>

  <!-- 
    【基础车身链接（base_Link）】
    核心修改：碰撞体尺寸/位置优化，完全避开车轮，无干涉
  -->
  <link name="base_Link">
    <!-- 惯性参数：质量2kg，转动惯量适配小车尺寸 -->
    <inertial>
      <origin xyz="-0.0098481 5.9245E-07 0.010215" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.0004144" ixy="0.00000001849" ixz="0.0000007185"
               iyy="0.0003855" iyz="0.00000000001813" izz="0.0007036" />
    </inertial>

    <!-- 视觉模型：加载STL网格文件，红色车身 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/base_Link.STL" />
      </geometry>
      <material name="base_material">
        <color rgba="1 0 0 1" />  <!-- RGBA：红(1),绿(0),蓝(0),不透明(1) -->
      </material>
    </visual>

    <!-- 
      【修改点3：碰撞体优化】
      设计逻辑：
      1. z轴上移至0.04m（车轮z范围0.0175~0.0275m），避开车轮高度
      2. x尺寸0.07m（±0.035m），窄于车轮x内侧范围（-0.055861~0.041864m）
      3. y尺寸0.1m（±0.05m），窄于车轮y内侧范围（-0.066996~0.066996m）
      效果：完全无重合，消除碰撞干涉
    -->
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />  <!-- z轴上移避开车轮 -->
      <geometry>
        <box size="0.07 0.1 0.02" />  <!-- x:0.07 | y:0.1 | z:0.02 -->
      </geometry>
    </collision>

    <!-- Gazebo材质：红色（与视觉一致） -->
    <gazebo reference="base_Link">
      <material>Gazebo/Red</material>
    </gazebo>
  </link>

  <!-- 
    【车轮0链接（wheel_0_Link）】
    核心修改：
    1. 安装角度改为标准-45°（-π/4=0.7854rad），保证麦轮驱动力对称
    2. 关节添加阻尼/摩擦，统一转动阻力
  -->
  <link name="wheel_0_Link">
    <!-- 惯性参数：质量0.07kg，适配麦轮重量 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>

    <!-- 视觉模型：加载麦轮STL，黄色 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_0_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />  <!-- 黄色 -->
      </material>
    </visual>

    <!-- 碰撞体：简化为圆柱体（替代复杂网格，提升仿真效率） -->
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0" />  <!-- 绕x轴旋转90°，适配车轮朝向 -->
      <geometry>
        <cylinder length="0.01" radius="0.029" />  <!-- 长度0.01m，半径0.029m -->
      </geometry>
    </collision>

    <!-- 
      Gazebo物理参数：统一所有车轮参数，保证摩擦/阻尼一致
      mu1/mu2：摩擦系数（1.2/1.0）
      slip1/slip2：滑动系数（0.02），避免单侧打滑
      rolling_friction：滚动阻尼（0.1），统一滚动阻力
    -->
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>1.2</mu2>
      <fdir1>1 0 0</fdir1>
      <min_depth>0.001</min_depth>
      <slip1>0</slip1>
      <slip2>0.05</slip2>
      <soft_cfm>1e-7</soft_cfm>
      <soft_erp>0.8</soft_erp>
      <!--<rolling_friction>0.1</rolling_friction>-->
    </gazebo>
    <gazebo reference="wheel_0_Link">
      <material>Gazebo/Black</material>  <!-- 黑色车轮 -->
    </gazebo>
  </link>

  <!-- 车轮0关节：标准-45°角度 + 关节阻尼 -->
  <joint name="wheel_0_Joint" type="continuous">
    <origin xyz="0.055861 0.055861 0.0225" rpy="0 0 -0.7854" />  <!-- 【修改点4】角度改为-π/4（-45°） -->
    <parent link="base_Link" />
    <child link="wheel_0_Link" />
    <axis xyz="0 1 0" />  <!-- 绕y轴旋转（车轮转动轴） -->
    <!-- 【修改点5：添加关节阻尼/摩擦】damping=0.3（粘性阻尼），friction=0.1（库仑摩擦） -->
    <dynamics damping="0.0" friction="0.0" />
  </joint>

  <!-- 
    【车轮1链接（wheel_1_Link）】
    与wheel_0参数完全一致，保证对称
  -->
  <link name="wheel_1_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_1_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>1.2</mu2>
      <fdir1>1 0 0</fdir1>
      <min_depth>0.001</min_depth>
      <slip1>0</slip1>
      <slip2>0.05</slip2>
      <soft_cfm>1e-7</soft_cfm>
      <soft_erp>0.8</soft_erp>
      <!--<rolling_friction>0.1</rolling_friction>-->
    </gazebo>
    <gazebo reference="wheel_1_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮1关节：标准-135°角度 + 关节阻尼 -->
  <joint name="wheel_1_Joint" type="continuous">
    <origin xyz="0.055861 -0.055861 0.0225" rpy="0 0 -2.3562" />  <!-- 【修改点6】角度改为-3π/4（-135°） -->
    <parent link="base_Link" />
    <child link="wheel_1_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.0" friction="0.0" />  <!-- 与wheel_0相同阻尼 -->
  </joint>

  <!-- 
    【车轮2链接（wheel_2_Link）】
    与wheel_0/1参数完全一致，保证对称
  -->
  <link name="wheel_2_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_2_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>1.2</mu2>
      <fdir1>1 0 0</fdir1>
      <min_depth>0.001</min_depth>
      <slip1>0</slip1>
      <slip2>0.05</slip2>
      <soft_cfm>1e-7</soft_cfm>
      <soft_erp>0.8</soft_erp>
      <!--<rolling_friction>0.1</rolling_friction>-->
    </gazebo>
    <gazebo reference="wheel_2_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮2关节：标准135°角度 + 关节阻尼 -->
  <joint name="wheel_2_Joint" type="continuous">
    <origin xyz="-0.055861 -0.055861 0.0225" rpy="0 0 2.3562" />  <!-- 【修改点7】角度改为3π/4（135°） -->
    <parent link="base_Link" />
    <child link="wheel_2_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.0" friction="0.0" />  <!-- 与其他车轮相同阻尼 -->
  </joint>

  <!-- 
    【车轮3链接（wheel_3_Link）】
    与wheel_0/1/2参数完全一致，保证对称
  -->
  <link name="wheel_3_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.07" />
      <inertia ixx="0.00001477" ixy="0" ixz="0"
               iyy="0.00002940" iyz="0" izz="0.00001477" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/wheel_3_Link.STL" />
      </geometry>
      <material name="wheel_material">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.01" radius="0.029" />
      </geometry>
    </collision>
    <gazebo>
      <mu1>1.5</mu1>
      <mu2>1.2</mu2>
      <fdir1>1 0 0</fdir1>
      <min_depth>0.001</min_depth>
      <slip1>0</slip1>
      <slip2>0.05</slip2>
      <soft_cfm>1e-7</soft_cfm>
      <soft_erp>0.8</soft_erp>
      <!--<rolling_friction>0.1</rolling_friction>-->
    </gazebo>
    <gazebo reference="wheel_3_Link">
      <material>Gazebo/Black</material>
    </gazebo>
  </link>

  <!-- 车轮3关节：标准45°角度 + 关节阻尼 -->
  <joint name="wheel_3_Joint" type="continuous">
    <origin xyz="-0.055861 0.055861 0.0225" rpy="0 0 0.7854" />  <!-- 【修改点8】角度改为π/4（45°） -->
    <parent link="base_Link" />
    <child link="wheel_3_Link" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.0" friction="0.0" />  <!-- 与其他车轮相同阻尼 -->
  </joint>

  <!-- 
    【机械臂/嘴巴链接（mouth_Link）】
    核心修改：
    1. 移除<collision>标签，彻底关闭碰撞体
    2. 添加collision_bitmask=0x0000，强化碰撞禁用
  -->
  <link name="mouth_Link">
    <!-- 惯性参数：质量0.20952kg，适配机械臂重量 -->
    <inertial>
      <origin xyz="0.0061665 -0.041178 0.033013" rpy="0 0 0" />
      <mass value="0.20952" />
      <inertia ixx="4.8361E-05" ixy="-3.4805E-08" ixz="-1.004E-07"
               iyy="1.5441E-05" iyz="2.5967E-08" izz="4.7443E-05" />
    </inertial>

    <!-- 视觉模型：加载机械臂STL，蓝色 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/mouth_Link.STL" />
      </geometry>
      <material name="mouth_material">
        <color rgba="0 0 1 1" />  <!-- 蓝色 -->
      </material>
    </visual>

    <!-- 【修改点9：移除碰撞体】原<collision>标签已删除，关闭物理碰撞 -->

    <!-- Gazebo配置：碰撞掩码0x0000（完全无碰撞）+ 阻尼0.2 -->
    <gazebo reference="mouth_Link">
      <material>Gazebo/Blue</material>
      <damping>0.2</damping>
      <collision_bitmask>0x0000</collision_bitmask>  <!-- 碰撞掩码：0表示无碰撞 -->
    </gazebo>
  </link>

  <!-- 机械臂关节：转动范围0~0.16rad（约9.17°） -->
  <joint name="mouth_Joint" type="revolute">
    <origin xyz="0.0519 0.04365 0.0113" rpy="0 0 0" />
    <parent link="base_Link" />
    <child link="mouth_Link" />
    <axis xyz="0 1 0" />  <!-- 绕y轴转动 -->
    <limit lower="0" upper="0.16" effort="150" velocity="0.8" />  <!-- 限位+最大力矩/速度 -->
  </joint>

  <!-- 
    【运球机构链接（dribble_Link）】
    核心修改：
    1. 移除<collision>标签，关闭物理碰撞
    2. 添加collision_bitmask=0x0000，强化碰撞禁用
  -->
  <link name="dribble_Link">
    <!-- 惯性参数：质量0.017857kg，适配轻质运球轮 -->
    <inertial>
      <origin xyz="2.2549E-05 0.0019168 0.00014443" rpy="0 0 0" />
      <mass value="0.017857" />
      <inertia ixx="7.3784E-06" ixy="-7.9042E-10" ixz="1.8567E-10"
               iyy="2.5482E-07" iyz="-3.6986E-09" izz="7.3795E-06" />
    </inertial>

    <!-- 视觉模型：加载运球机构STL，绿色 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/yixi/ROS/zjunlict/src/robot/meshes/dribble_Link.STL" />
      </geometry>
      <material name="dribble_material">
        <color rgba="0 1 0 1" />  <!-- 绿色 -->
      </material>
    </visual>

    <!-- 【修改点10：移除碰撞体】原<collision>标签已删除，关闭物理碰撞 -->

    <!-- Gazebo配置：碰撞掩码0x0000（完全无碰撞）+ 阻尼0.1 -->
    <gazebo reference="dribble_Link">
      <material>Gazebo/Green</material>
      <damping>0.1</damping>
      <collision_bitmask>0x0000</collision_bitmask>  <!-- 碰撞掩码：0表示无碰撞 -->
    </gazebo>
  </link>

  <!-- 运球机构关节：连续转动（无限位） -->
  <joint name="dribble_Joint" type="continuous">
    <origin xyz="0.015669 -0.0459 0.027271" rpy="0 -0.18761 0" />
    <parent link="mouth_Link" />
    <child link="dribble_Link" />
    <axis xyz="0 -1 0" />  <!-- 绕-y轴转动（运球轮旋转轴） -->
  </joint>

</robot>

